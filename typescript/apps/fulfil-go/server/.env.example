# Local dev env for @fulfil-go/server. Copy to `.env` (gitignored) and adjust.
# `pnpm dev` loads it via `--env-file-if-exists=.env`. Prod injects these from
# the deploy environment instead — do NOT ship a .env to prod.

# ── Server ──────────────────────────────────────────────────────────────────
# 3200 avoids fc-dev (:3000/:8080), pinpoint (:3100). Must match the vite
# proxy target in the apps' vite.config.ts.
PORT=3200
HOST=0.0.0.0
LOG_LEVEL=debug

# ── Database — pick ONE ──────────────────────────────────────────────────────
# Option A — fc-dev's embedded Postgres (port 15432). Start the flowcatalyst
# platform first (it hosts the instance), then `pnpm db:init && pnpm
# db:migrate` — db:init creates the separate `fulfilgo` database on it
# (NEVER point at the platform's own db: db:init does an ALTER ROLE …
# SET search_path you don't want applied there).
DATABASE_URL=postgresql://postgres:postgres@localhost:15432/fulfilgo?sslmode=disable
# Option B — the throwaway docker container from `pnpm db:up` (port 5434):
# DATABASE_URL=postgresql://fulfilgo:fulfilgo@localhost:5434/fulfilgo

# Local uses `pnpm db:init` + `pnpm db:migrate`; leave startup auto-migrate off.
FULFILGO_DB_AUTO_MIGRATE=false

# ── Auth ─────────────────────────────────────────────────────────────────────
# Dev fallback: authenticate with an `x-user-id: <principal>` header (grants
# ALL permissions). The apps' browser dev mode relies on this. NEVER in prod.
FULFILGO_AUTH_DEV_FALLBACK=true
# Real OIDC against the platform (mobile PKCE brokering + JWT validation);
# leave OIDC_ISSUER_URL unset to keep the auth routes 503 in local dev.
# Topology: ONE OAuth client per user-facing app — provision three clients on
# the platform (fc-dev init creates the first; add the rest in the platform
# admin) and paste their ids/secrets here. Each app names itself via the
# `app` field on /auth/mobile/*; redirect allowlists default per app
# (deep-link scheme + its localhost dev origin — see src/auth/auth-config.ts).
# OIDC_ISSUER_URL=http://localhost:8080
# OIDC_SCOPES=openid profile email offline_access
# FULFILGO_OIDC_EXECUTION_CLIENT_ID=oac_...
# FULFILGO_OIDC_EXECUTION_CLIENT_SECRET=
# FULFILGO_OIDC_PICKING_CLIENT_ID=oac_...
# FULFILGO_OIDC_PICKING_CLIENT_SECRET=
# FULFILGO_OIDC_MANAGEMENT_CLIENT_ID=oac_...
# FULFILGO_OIDC_MANAGEMENT_CLIENT_SECRET=
# Per-app redirect override (comma-separated):
# FULFILGO_OIDC_EXECUTION_REDIRECT_URIS=
# Single-client fallback (requests without `app`) — handy in dev:
# OIDC_CLIENT_ID=fulfil-go
# OIDC_CLIENT_SECRET=
# FULFILGO_AUTH_REDIRECT_URIS=

# ── Picker session auth (shared-station picking app) ─────────────────────────
# fulfil-go ISSUES these tokens itself (separate plane from platform OIDC — see
# docs/pick-context-auth.md). HS256-signed with the secret below. Unset in dev
# falls back to a built-in insecure secret (boot warns). REQUIRED in prod.
# PICKER_SESSION_SECRET=
# PICKER_SESSION_ISSUER=fulfilgo-pick   # also the token-routing key
# PICKER_ACCESS_TTL=900                 # access token seconds (15 min)
# PICKER_REFRESH_TTL=43200              # refresh token seconds (12 h)
# PICKER_PIN_MAX_ATTEMPTS=5             # failed PINs before lockout
# PICKER_LOCK_MINUTES=5                 # lockout duration

# ── FlowCatalyst integration ─────────────────────────────────────────────────
# Local diagnostic tag on outbox rows (never sent to the platform). Default
# is fine — only set to distinguish apps sharing one outbox table.
# FLOWCATALYST_APPLICATION_CODE=fulfil-go
# NOTE: FLOWCATALYST_CLIENT_ID / FLOWCATALYST_CLIENT_SECRET are reserved for
# the fc-dev outbox poller (it reads them as its OAuth client-credentials
# pair and mints its own tokens). fc-dev outbox also reads:
# FC_OUTBOX_SOURCE_DB_URL="postgres://postgres:postgres@127.0.0.1:15432/fulfilgo"
# FC_OUTBOX_PLATFORM_URL=http://localhost:8080
# Platform base URL + service-account creds for `pnpm flowcatalyst:sync`
# (registers event types / roles / scheduled jobs on the platform):
# FLOWCATALYST_URL=http://localhost:8080
# FLOWCATALYST_API_CLIENT_ID=oac_...
# FLOWCATALYST_API_CLIENT_SECRET=...
# Inbound scheduled-job/webhook HMAC secret (unset = dev-mode bypass):
# FLOWCATALYST_SIGNING_SECRET=
