{
  "name": "@pinpoint/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "api:types": "openapi-typescript ../openapi.gen.json -o src/api/schema.gen.d.ts",
    "api:types:check": "openapi-typescript ../openapi.gen.json 2>/dev/null | diff -q - src/api/schema.gen.d.ts >/dev/null || (echo \"src/api/schema.gen.d.ts is stale — run pnpm api:types\" && exit 1)"
  },
  "dependencies": {
    "@flowcatalyst-apps/web-kit": "workspace:*",
    "@primeuix/themes": "^2.0.3",
    "@vee-validate/zod": "^4.15.1",
    "leaflet": "^1.9.4",
    "openapi-fetch": "^0.17.0",
    "pinia": "^3.0.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.4",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@primevue/auto-import-resolver": "^4.5.4",
    "@types/leaflet": "^1.9.8",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "^5.2.3",
    "openapi-typescript": "^7.13.0",
    "typescript": "catalog:",
    "unplugin-vue-components": "^31.0.0",
    "vite": "^7.0.0",
    "vue-tsc": "^2.2.0"
  }
}
