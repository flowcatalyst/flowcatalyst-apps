{
  "name": "@flowcatalyst-apps/root",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "dev:pinpoint": "pnpm --parallel --filter @pinpoint/server --filter @pinpoint/web dev",
    "dev:fulfil-go": "pnpm --parallel --filter @fulfil-go/server --filter @fulfil-go/execution-app --filter @fulfil-go/picking-app --filter @fulfil-go/management-app dev",
    "sync:fulfil-go": "pnpm --filter @fulfil-go/server flowcatalyst:sync",
    "build": "vp build",
    "test": "vp test",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "lint": "vp check --no-fmt",
    "format": "vp check --no-lint --fix",
    "format:check": "vp check --no-lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "run": "vp run",
    "clean": "pnpm -r exec rm -rf dist .turbo .vite .vite-plus",
    "openapi:pinpoint": "pnpm --filter @pinpoint/server openapi:export && pnpm --filter @pinpoint/web api:types && pnpm --filter @pinpoint/flows gen",
    "openapi:pinpoint:check": "pnpm --filter @pinpoint/server openapi:check && pnpm --filter @pinpoint/web api:types:check && pnpm --filter @pinpoint/flows gen:check",
    "flows:pinpoint": "pnpm --filter @pinpoint/flows flows",
    "api:lint": "spectral lint apps/pinpoint/openapi.gen.json --ruleset ../.spectral.yaml",
    "api:breaking": "../scripts/api-breaking.sh",
    "api:check": "pnpm api:lint && pnpm api:breaking"
  },
  "devDependencies": {
    "@stoplight/spectral-cli": "^6.16.3",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.1.2"
}
